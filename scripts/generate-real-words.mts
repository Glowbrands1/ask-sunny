/**
 * Writes `src/lib/forms/real-words.ts`: the real English words the card's account mender (`account-spelling.ts`) could
 * otherwise take for a typo — every dictionary word that `typo-match.ts` `onlyMatch` would weigh against one of the
 * mender's words (same first letter, not an inflection, within its allowed edits). QA (14 Nov 2026): a real word is
 * never mended ("she complained to a guest" is not "complaint").
 *
 * The dictionary is the MIT-licensed `an-array-of-english-words` (2.0.0), fetched outside the repository:
 *   npm pack an-array-of-english-words@2.0.0 && tar -xzf an-array-of-english-words-2.0.0.tgz
 *   npx tsx --tsconfig tsconfig.json scripts/generate-real-words.mts package/index.json
 * Run it again when the mender's word list changes.
 */
import { readFileSync, writeFileSync } from "node:fs";

import { ACCOUNT_WORDS } from "../src/lib/forms/account-spelling";
import { allowed, editDistance, inflects } from "../src/lib/forms/typo-match";
import { typoVocabulary } from "../src/lib/forms/typo-vocabulary";

const dictionary: string[] = JSON.parse(readFileSync(process.argv[2]!, "utf8"));
const list = [...new Set([...typoVocabulary(), ...ACCOUNT_WORDS])];
const listed = new Set(list);
const real = new Set<string>();
for (const word of dictionary) {
  if (!/^[a-z]{5,}$/.test(word) || listed.has(word)) continue;
  for (const candidate of list) {
    if (candidate[0] !== word[0] || Math.abs(candidate.length - word.length) > allowed(candidate)) continue;
    if (inflects(word, candidate)) continue;
    if (editDistance(word, candidate) <= allowed(candidate)) {
      real.add(word);
      break;
    }
  }
}
const words = [...real].sort();
const lines: string[] = [];
for (let i = 0; i < words.length; i += 8) lines.push(`  ${words.slice(i, i + 8).map((word) => JSON.stringify(word)).join(", ")},`);
writeFileSync(
  "src/lib/forms/real-words.ts",
  `/**
 * GENERATED by \`scripts/generate-real-words.mts\` from the MIT-licensed \`an-array-of-english-words\` (2.0.0): the real
 * English words within the account mender's reach of one of its words. A real word is never mended (QA, 14 Nov 2026).
 * Do not edit by hand; run the script again when the mender's word list changes.
 */
export const REAL_WORDS: ReadonlySet<string> = new Set([
${lines.join("\n")}
]);
`,
);
console.log(`${words.length} real words written`);
