/**
 * Writes `src/lib/forms/common-words.ts`: the common English words (SCOWL sizes 10, 20 and 35, "english" and
 * "american"), lowercase letters only, three letters or more. The spelling cleanup check (`spelling-cleanup.ts`) asks a
 * near miss of a roster name that is also a common word for more ("west" is not a respelled "was"; QA, 14 Nov 2026).
 *
 * The lists come from the MIT-licensed `wordlist-english` (1.2.1), which packages SCOWL, fetched outside the repository:
 *   npm pack wordlist-english@1.2.1 && tar -xzf wordlist-english-1.2.1.tgz
 *   npx tsx scripts/generate-common-words.mts package
 */
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const dir = process.argv[2]!;
const words = new Set<string>();
for (const size of ["10", "20", "35"]) {
  for (const dialect of ["english", "american"]) {
    for (const word of JSON.parse(readFileSync(join(dir, `${dialect}-words-${size}.json`), "utf8")) as string[]) {
      if (/^[a-z]{3,}$/.test(word)) words.add(word);
    }
  }
}
const sorted = [...words].sort();
writeFileSync(
  "src/lib/forms/common-words.ts",
  `/**
 * GENERATED by \`scripts/generate-common-words.mts\` (${sorted.length} words): the common English words of SCOWL sizes 10,
 * 20 and 35, from \`wordlist-english\` 1.2.1. Do not edit by hand.
 *
 * SCOWL is Copyright 2000-2016 by Kevin Atkinson. Permission to use, copy, modify, distribute and sell these word lists,
 * the associated scripts, the output created from the scripts, and its documentation for any purpose is hereby granted
 * without fee, provided that the above copyright notice appears in all copies and that both that copyright notice and
 * this permission notice appear in supporting documentation. Kevin Atkinson makes no representations about the
 * suitability of this array for any purpose. It is provided "as is" without express or implied warranty.
 */
export const COMMON_WORDS: ReadonlySet<string> = new Set(${JSON.stringify(sorted.join(" "))}.split(" "));
`,
);
console.log(`${sorted.length} common words written`);
