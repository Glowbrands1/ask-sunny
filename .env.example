# Ask Sunny — environment variables.
#
# PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local (which is gitignored) and fill it in there.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle and are
# therefore PUBLIC. Everything else is server-only and must never be given a
# NEXT_PUBLIC_ prefix.

# ---------------------------------------------------------------- Mode -----
# Read through isDemoMode() in src/lib/config/runtime.ts, which is the only
# place this variable is interpreted. Three states, and they are exhaustive:
#
#   "false"  live mode: Supabase + Anthropic are required, and a missing one
#            produces an error rather than a demo answer. The login screen
#            offers no demo entry, so nobody can sign in until a real identity
#            provider is connected.
#   "true"   demo mode: seeded content, mock provider, no external services.
#   unset    demo mode, identical to "true". Only the exact string "false"
#            selects live mode, so a typo cannot silently point a prototype at
#            live services.
#
# Salon Performance is the exception and does not consult this at all: it reads
# real reporting data from Supabase in either mode.
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------ Report ingestion (machine auth) -
# SERVER ONLY, and deliberately not NEXT_PUBLIC_. Required on every call to
# POST /api/admin/reporting/ingest, in every environment. No credential means
# no ingestion — the route refuses everybody rather than falling open.
#
# A MACHINE credential, not a person's: it identifies a delivery pipeline,
# carries no profile or role, and must never be reused as employee login. It is
# production-capable on its own and depends on no external identity provider.
#
# FORMAT — one or more entries, comma or whitespace separated:
#     <secret>                       one credential, id defaults to `default`
#     <id>:<secret>                  one labelled credential
#     <id>:<secret>,<id>:<secret>    several, which is what rotation needs
#
# The id is an operator label (`power-automate`, `monthly-job`) and is not a
# secret: it is returned on a successful ingestion so an audit line can say
# which pipeline filed a report and which credential to revoke.
#
# ROTATE by adding the new entry, moving the caller over, then removing the old
# one — three deploys, no window where ingestion is broken. REVOKE by removing
# an entry and redeploying.
#
# Each secret must be at least 24 characters; a shorter entry is dropped and
# the readiness endpoint says so. Generate one, do not invent one:
#     openssl rand -base64 32
#
# Present it as `Authorization: Bearer <secret>` or in the
# `X-Reporting-Ingest-Secret` header. NEVER in a query string — a secret in a
# URL is written to every log between the caller and the route.
REPORTING_INGEST_SECRET=

# ------------------------------------- Inbound report email (Resend) --------
# The report arrives as a forwarded email rather than an HTTP call:
#
#   Samuel emails Curt the Comp Report
#     -> an Outlook rule forwards a copy to the Resend inbound address
#     -> Resend emits `email.received`
#     -> POST /api/reporting/inbound-email verifies, gates, downloads the .xlsx
#     -> the same intake orchestration runs every applicable parser
#
# All three are SERVER ONLY and deliberately not NEXT_PUBLIC_.

# The webhook signing secret Resend shows ONCE when the webhook is created.
# Starts `whsec_`. Every delivery is verified against it over the RAW request
# body before anything is parsed, downloaded or written; a runtime without it
# refuses every delivery rather than trusting one.
RESEND_WEBHOOK_SECRET=

# A Resend API key with permission to read received email. The webhook carries
# attachment METADATA only, so the bytes are fetched from the receiving API.
# Sent to api.resend.com and nowhere else — never to an attachment's signed
# download URL, which points at a different host.
RESEND_API_KEY=

# Comma-separated list of addresses whose mail may become reporting data.
# EXACT addresses, case and whitespace normalized. No domain wildcards: a rule
# like "anything at the company" would let any colleague file figures by
# replying to the thread.
#
#   REPORTING_APPROVED_SENDERS=you@yourcompany.com,Samuel.Brockie@glowbrands.com
#
# Not authentication — a From address is trivially forged, and the webhook
# SIGNATURE is what proves a delivery is genuine. This is the narrower question
# of whose report we agreed to ingest. Unset means nobody is admitted.
# Removing the test address later is an edit here, not a code change.
REPORTING_APPROVED_SENDERS=

# ------------------------------------------- Sales Totals email ingestion ---
# The SAME inbound mailbox and the SAME webhook as the Comp Report. One
# endpoint serves both; they are told apart by sender and subject.
#
#   the reporting system emails the Sales Totals report
#     -> an Outlook rule forwards a copy to the same Resend inbound address
#     -> POST /api/reporting/inbound-email verifies, routes, downloads
#     -> the Sales Totals parser reads it and one transaction writes the day
#
# Comma-separated EXACT addresses, as above. No domain wildcards. This is the
# ONLY thing standing between the report and ingestion, so unset admits nobody
# — which is why it is configuration rather than a default in the code: a test
# address has to be removable without a release.
#
#   SALES_TOTALS_APPROVED_SENDERS=reports@suntancity.com
#
SALES_TOTALS_APPROVED_SENDERS=

# OPTIONAL. The subject fragment a Sales Totals delivery must carry, matched
# case-insensitively with whitespace collapsed. Defaults to "sales totals",
# which matches the observed subject ("Sales Totals for Bowen"); set it only to
# narrow further, e.g. to one recipient's copy.
SALES_TOTALS_SUBJECT_FRAGMENT=

# ---------------------------------------- Reporting access: NONE -----------
# THERE IS NO VARIABLE HERE, AND THAT IS THE POINT.
#
# /reports/salon-performance renders real salon-level financials and NOTHING
# GUARDS IT. The temporary stakeholder-review password gate that used to stand
# in front of it was removed at the owner's explicit instruction, and the app's
# own sign-in is demo mode — anybody can click "Preview demo" and is inside.
#
# So the reporting dashboard is readable by anyone who has the URL, on every
# environment this is deployed to. Treat the deployment hostname as the only
# thing standing between a competitor and comparable-store revenue by location.
#
# THE FIX IS EMPLOYEE LOGIN, not another shared password. Supabase Auth is the
# default choice — see docs/architecture-constraints.md §3. Until it ships,
# limit who has the URL.

# ------------------------------------------------------------ Supabase -----
# Project URL. Public by design.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (`sb_publishable_...`) — browser-safe, protected by row level
# security. Not read by any code path yet; it becomes required when
# authentication ships and the browser starts talking to Supabase directly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Secret key (`sb_secret_...`) — bypasses row level security
# entirely. Used exclusively inside route handlers for ingestion, signed
# download URLs, and calling the `embed` Edge Function.
# Never expose this to the browser. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy alternative, still accepted if SUPABASE_SECRET_KEY is unset. Supabase
# is retiring the anon/service_role JWT keys in favour of the publishable/secret
# pair above; a newly created project is issued both. Prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- Claude ------
# SERVER ONLY. Read in src/lib/ai/anthropic.ts, which is marked `server-only`.
ANTHROPIC_API_KEY=

# Optional overrides. The defaults live in src/lib/config/models.ts.
# ANTHROPIC_MODEL=
# ANTHROPIC_EFFORT=

# --------------------------------------------------- Authentication --------
# SERVER ONLY, and normally unset.
#
# Live mode refuses protected functionality until a real identity provider is
# configured. Setting this to exactly "true" bypasses that refusal, for the one
# pre-authentication acceptance test that proves upload -> retrieval -> answer
# works against real credentials.
#
# IT CANNOT OPERATE IN PRODUCTION. The bypass is gated on NODE_ENV, so in a
# production build (`next build` / `next start`, and therefore every real
# deployment) it is inert whatever it is set to. Setting it there changes
# nothing except a SECURITY line in the log telling you it was ignored.
#
# Usable only under `next dev` or the test runner.
# ALLOW_UNAUTHENTICATED_LIVE_ACCESS=

# --------------------------------------------------------- Embeddings ------
# NO VARIABLE REQUIRED.
#
# Documents and questions are embedded by the `gte-small` model running inside
# the project's own Supabase Edge Function (supabase/functions/embed). There is
# no embedding vendor and no embedding API key: the Supabase URL and secret key
# above are the whole credential set.
#
# The model and its output dimension are set in src/lib/config/models.ts and
# must stay in step with the pgvector column width in supabase/migrations.
